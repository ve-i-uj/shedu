# Changes in kbengine.xml
#
# 16 hexadecimal output
# root.trace_packet.debug_type=1
#
# The file contained serialized messages in 16 hex view
# root.trace_packet.use_logfile=appname_packetlogs.log
#
# Debug all message (no exlude)
# root.trace_packet.use_logfile.disables=""
#
# Enable entity log info
# root.debugEntity=1
# 
# Disable encrypted communication 
# root.channelCommon.encrypt_type=0
# 
